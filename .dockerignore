# .dockerignore - common patterns to keep out of Docker build context

# VCS
.git
.gitignore
.gitattributes

# OS files
.DS_Store
Thumbs.db

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pytest_cache/
venv/
env/
ENV/
.venv/
envguardrails/

# Java / Maven / Gradle
target/
build/
.gradle/
.gradle-*
*.class
*.jar
*.war
*.ear

# Go
bin/
*.exe
*.test
vendor/

# Ruby
.bundle
log/
tmp/
*.gem

# PHP / Composer
vendor/
composer.lock

# .NET
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rust
target/

# Elixir/Erlang
deps/
_build/

# General build/artifacts
dist/
build/
coverage/
coverage.*
.cache/
.cache-loader/
*.map
*.zip
*.tar
*.gz

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs and runtime files
logs/
*.log
*.pid
*.seed
*.sock
.tmp/
tmp/

# Secrets and environment config
.env
.env.local
.env.*.local
secrets/
*.pem
*.key
*.crt
credentials.yml
credentials.json

# Docker and CI
.dockerignore
docker-compose.override.yml
Dockerfile.*
Dockerfile.dev

# Misc
npm-debug.log*
yarn.lock
pnpm-lock.yaml
.lock-wscript
coverage/
bower_components/
jspm_packages/
uploads/
.idea/

# Keep package manifests (if you want them in context, remove these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml